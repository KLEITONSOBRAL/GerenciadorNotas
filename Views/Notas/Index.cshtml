@model List<GerenciadorNotas.Models.Nota>

@{
    ViewData["Title"] = "Minhas Notas";
}

<h1>Minhas Notas</h1>

<a asp-action="Cadastrar" class="btn btn-primary mb-3">
    Nova Nota
</a>

<hr />

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Nenhuma nota cadastrada.
    </div>
}
else
{
    foreach (var nota in Model)
    {
        <div class="card mb-3">

            <div class="card-body">

                <h3 class="card-title">
                    @nota.Titulo
                </h3>

                <p class="card-text">
                    @nota.Conteudo
                </p>

                <p class="text-muted">
                    Criada em:
                    @nota.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                </p>

                <div class="d-flex gap-2">

                    <a asp-action="Detalhes"
                       asp-route-id="@nota.Id"
                       class="btn btn-info">
                        Detalhes
                    </a>

                    <a asp-action="Editar"
                       asp-route-id="@nota.Id"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a asp-action="Excluir"
                       asp-route-id="@nota.Id"
                       class="btn btn-danger">
                        Excluir
                    </a>

                </div>

            </div>

        </div>
    }
}